export HARNESS_SEED_OLD="$(cat /tmp/seed-old.txt)"
export HARNESS_SEED_NEW="$(cat /tmp/seed-new.txt)"
export HARNESS_SEED_PP="$(cat /tmp/seed-pp.txt)"
export HARNESS_WALLET_PW=harness_pp_password
# Passphrase encrypting the offline signer's keystore. Mode 3 refuses to start without it: the
# payment processor shells out to the signer for every batch and cannot decrypt the keys
# otherwise. The keystore lives in the OS keyring, so this is not stored in the data directory.
export HARNESS_SIGNER_PASSPHRASE=harness_signer_passphrase
